{
  "name": "atrvisu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "call \"%npm_node_execpath%\" ./node_modules/vite/bin/vite.js",
    "build": "call \"%npm_node_execpath%\" ./node_modules/typescript/bin/tsc -b && call \"%npm_node_execpath%\" ./node_modules/vite/bin/vite.js build",
    "preview": "call \"%npm_node_execpath%\" ./node_modules/vite/bin/vite.js preview",
    "test": "call \"%npm_node_execpath%\" ./node_modules/vitest/vitest.mjs run",
    "test:watch": "call \"%npm_node_execpath%\" ./node_modules/vitest/vitest.mjs",
    "test:unit": "call \"%npm_node_execpath%\" ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "call \"%npm_node_execpath%\" ./node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "call \"%npm_node_execpath%\" ./node_modules/@playwright/test/cli.js test --headed"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.2",
    "@babylonjs/loaders": "^7.54.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
